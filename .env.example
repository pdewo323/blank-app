# AI Autonomous Hedge Fund - Environment Configuration
# Copy this file to ".env" and fill in your keys.

# Your Groq API key (required for the Groq and Hermes agents)
GROQ_API_KEY=your_groq_api_key_here

# Your OpenAI API key (optional, used if you add OpenAI-based agents)
OPENAI_API_KEY=your_openai_api_key_here

